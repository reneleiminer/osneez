# =============================================================================
# OSNEEZ — environment variables
# Copy to .env.local for development and add the same keys in Vercel.
# NEVER commit real values. Only NEXT_PUBLIC_* keys reach the browser.
# =============================================================================

# --- Site --------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for metadata, canonicals, sitemap.
NEXT_PUBLIC_SITE_URL=https://osneez.vercel.app

# --- Supabase ----------------------------------------------------------------
# Project URL and anon key are public by design (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://krkwiiikdlkzuuwygjsb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the client, never commit.
# Required for newsletter signups and Stripe order sync.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ------------------------------------------------------------------
# Server-only secret key (sk_test_… / sk_live_…).
STRIPE_SECRET_KEY=

# Signing secret of the checkout webhook endpoint (whsec_…).
# Endpoint: POST {NEXT_PUBLIC_SITE_URL}/api/stripe/webhook
# Events:   checkout.session.completed,
#           checkout.session.async_payment_succeeded,
#           checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=

# --- Hero media (optional) ----------------------------------------------------
# Drop in the campaign film without touching component code. Leave empty to
# render the built-in cinematic placeholder.
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_POSTER_URL=
